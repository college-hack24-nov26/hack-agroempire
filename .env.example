# Krushi Drushti Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Firebase Realtime Database
# Target URL provided by the user:
# https://console.firebase.google.com/project/krushi-drishti/database/krushi-drishti-default-rtdb/data/~2F
FIREBASE_PROJECT_ID=krushi-drishti
FIREBASE_DATABASE_NAME=krushi-drishti-default-rtdb
FIREBASE_DATABASE_URL=https://krushi-drishti-default-rtdb.asia-southeast1.firebasedatabase.app

# Pl@ntNet API Key for Botanical Vision & Disease Diagnosis
PLANTNET_API_KEY=your_plantnet_api_key_here
PLANTNET_PROJECT=k-indian-subcontinent

# Optional Firebase Service Account Key (JSON string or path to JSON file for Admin SDK privileged access)
# If omitted, Firebase RTDB REST client operates with client rules
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_AUTH_SECRET=

# Edge AI & Vision Fallback Configuration
AI_VISION_CONFIDENCE_THRESHOLD=0.75
DEFAULT_LANGUAGE=mr
SUPPORTED_LANGUAGES=en,hi,mr
