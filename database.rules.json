{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "reports": {
      ".read": true,
      "$reportId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['crop', 'disease', 'village'])"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notifId": {
          // Farmers can only mark their own notifications as read; they cannot alter title/message/crop/disease
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || (newData.child('title').val() === data.child('title').val() && newData.child('message').val() === data.child('message').val()))"
        }
      }
    },
    "processedReports": {
      // Internal backend audit & idempotency guard - only backend Admin SDK has access
      ".read": false,
      ".write": false
    },
    "scans": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "testConnection": {
      ".read": true,
      ".write": true
    }
  }
}

